# ----- Required for the app to boot -----

# libSQL / Turso. The app refuses to boot if either is unset.
# Local dev: point at a local file, e.g. file:./data/crm.db (any token works).
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# HMAC signing key for session cookies AND email unsubscribe tokens.
# Generate with: openssl rand -hex 32
# REQUIRED in production — the app throws if unset when NODE_ENV=production.
# Use any non-empty string for local dev.
SESSION_SECRET=change-me-to-a-long-random-string

# ----- Optional built-in admin login -----

# A superuser login that bypasses the staff table. In production, BOTH must
# be set explicitly to enable this login — there are no default values.
# Leave blank to require staff-table login only.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ----- Stripe (platform + Connect) -----

# Platform-side keys. Required for any Stripe feature.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret from Stripe dashboard → Webhooks → your endpoint.
# Required for /api/stripe/webhook to accept events.
STRIPE_WEBHOOK_SECRET=whsec_...

# OAuth client ID for the "sign in to existing Stripe account" Connect flow.
# Optional — only needed if you enable that path; standard onboarding works
# without it. Find it at Stripe → Connect → Settings → OAuth integration.
STRIPE_CONNECT_CLIENT_ID=ca_...

# Platform fee per transaction in basis points (50 = 0.5%). Defaults to 50
# if unset. Set to 0 to disable.
STRIPE_APPLICATION_FEE_BPS=50

# ----- Maps -----

# Mapbox public token (pk.*). Required for the /map page.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Google Maps API key. Used for geocoding + map embeds on customer cards.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ----- Meta / Facebook Lead Ads (optional) -----

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=

# ----- App origin override (optional) -----

# Used when minting Stripe redirect URLs and email unsubscribe links.
# If unset, the app derives the origin from request headers, which is fine
# behind a single proxy. Set explicitly if you have multi-hop proxying.
NEXT_PUBLIC_APP_URL=
APP_URL=

# Login credentials. Change these for your setup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Any random string. Used to sign session cookies.
SESSION_SECRET=change-me-to-any-random-string
# Mapbox public token (pk.*). Required for /map. Get one free at mapbox.com.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Google Maps API key. Used by the customer card on the New Job page (geocoding + map embed).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Turso (libSQL) connection. Required for production deploy on Vercel.
# If unset, the app falls back to a local SQLite file at ./data/crm.db.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here
# Stripe. Required to charge cards from the Record Payment modal.
# Get these from https://dashboard.stripe.com/apikeys (use test keys in dev).
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Platform application fee in basis points (1 bp = 0.01%). 50 = 0.5%.
# Set to 0 to disable. Taken from each charge into the platform's Stripe.
STRIPE_APPLICATION_FEE_BPS=50
# Stripe Connect OAuth client ID (looks like ca_...). Required for the
# "Sign in to existing Stripe" button. Get it from Stripe dashboard →
# Connect → Settings → "OAuth integration".
STRIPE_CONNECT_CLIENT_ID=ca_...
# Google OAuth credentials for "Sign in with Google" on the login page.
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# (application type: Web). Add your origin's
# /api/auth/google/callback URL as an authorized redirect URI.
# A Google sign-in only succeeds if the returned email matches an existing
# staff record — no users are auto-provisioned.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Meta (Facebook) Lead Ads integration. Required to let companies connect a
# Facebook Page and pipe Lead Ad submissions into the CRM as leads.
#
# Setup:
#   1. Create a Meta app at https://developers.facebook.com/apps (type: Business).
#   2. Add the "Facebook Login for Business" product and add this redirect URI:
#        https://<your-domain>/api/integrations/meta/callback
#      (in dev: http://localhost:3000/api/integrations/meta/callback).
#   3. Add the "Webhooks" product, subscribe to the `page` object on the
#      `leadgen` field, and point the callback URL at:
#        https://<your-domain>/api/integrations/meta/webhook
#      Use the same string for `META_WEBHOOK_VERIFY_TOKEN` below and in the
#      Meta dashboard's "Verify Token" field.
#   4. Request the OAuth scopes: pages_show_list, pages_read_engagement,
#      pages_manage_metadata, leads_retrieval, ads_management. These need
#      App Review before they work for non-admin users in production.
#   5. Copy the App ID and App Secret from Settings → Basic.
META_APP_ID=
META_APP_SECRET=
# Optional. Defaults to {request-origin}/api/integrations/meta/callback. Set
# this only if you need to override the redirect (e.g. a fixed prod URL while
# developing against a tunnel).
META_REDIRECT_URI=
# Any random string. Must match the "Verify Token" set on the webhook in the
# Meta app dashboard. Used during the GET handshake on the webhook route.
META_WEBHOOK_VERIFY_TOKEN=
